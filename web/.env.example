# 複製呢個檔做 .env（同一目錄），再填入你嘅值。唔好將真正嘅 .env 上傳去 GitHub。
# Copy this file to .env (same folder) and fill in your values. Never commit the real .env.

# --- Google OAuth（必填）---
# 去 Google Cloud Console 建立 OAuth Client ID（Web application）取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth 完成後 Google 跳返嚟嘅網址；本地開發用下面呢個，部署後改做你嘅公開網址
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# --- Server（必填）---
# 生產環境請用隨機長字串；唔填會每次重啟自動產生（session 會失效）
SESSION_SECRET=change-me-to-a-long-random-string
PORT=3000
NODE_ENV=development

# --- AI 分類（optional，唔填就用內置規則式分類）---
# 支援任何 OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
